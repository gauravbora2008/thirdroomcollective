---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { seriesList } from "../../data/series";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Topics — Third Room"
  description="Browse Third Room podcasts and discussions by topic."
  current="topics"
>
  <div class="container">
    <header class="page-header">
      <h1>Topics</h1>
      <p class="subtitle">Podcasts and discussion summaries, grouped by subject.</p>
    </header>
    <ul class="content-list">
      {
        seriesList.map((topic) => (
          <li>
            <h2>
              <a href={`${base}topics/${topic.id}/`}>{topic.title}</a>
            </h2>
            <p class="sm muted">
              Recurring Saturday series. {topic.blurb} Events, summaries, and
              podcasts live here.
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
