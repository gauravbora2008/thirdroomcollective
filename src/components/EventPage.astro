---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  eventPath,
  eventTitle,
  formatLongDate,
  formatShortDate,
  getEvent,
  googleCalendarUrl,
} from "../data/events";
import { getSeries } from "../data/series";
import { siteLinks } from "../data/site";

interface Props {
  date: string;
  slug: string;
}

const { date, slug } = Astro.props;
const event = getEvent(date, slug);
if (!event) {
  throw new Error(`Unknown event: ${date}-${slug}`);
}

const series = getSeries(event.seriesId);
const base = import.meta.env.BASE_URL;
const path = eventPath(event);
const pageUrl = `https://gauravbora2008.github.io/thirdroomcollective/${path}`;
const calendarUrl = googleCalendarUrl(event, pageUrl);
const title = eventTitle(event);
const isUpcoming = event.date >= new Date().toISOString().slice(0, 10);
const registerUrl = siteLinks.registerFormUrl || "#register";
const registerReady = Boolean(siteLinks.registerFormUrl);
---

<BaseLayout
  title={`${title} — ${formatShortDate(event.date)} — Third Room`}
  description={`Third Room event: ${title}. ${event.question} ${formatLongDate(event.date)}, 12:00 noon IST.`}
  current="events"
>
  <article class="container narrow">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={base}>Home</a><span>/</span>
      <a href={`${base}events/`}>Events</a><span>/</span>
      {title}
    </nav>

    <header class="page-header">
      <span class="badge">{isUpcoming ? "Upcoming" : "Past"}</span>
      <h1>{title}</h1>
      <p class="subtitle">{event.question}</p>
      <div class="meta">
        <span>{formatLongDate(event.date)}</span>
        <span>12:00–13:00 IST</span>
        <span>Online</span>
        <span
          >Topic: <a href={`${base}topics/${series.id}/`}>{series.title}</a></span
        >
      </div>
    </header>

    <section class="content-block prose">
      <h2>About this event</h2>
      {
        event.summary ? (
          <p>{event.summary}</p>
        ) : (
          <p>
            Part of Third Room’s Saturday discussions. After the call, a
            discussion summary and podcast episode will be posted and linked
            from the topic page.
          </p>
        )
      }
      <p>
        Artifacts will be linked from
        <a href={`${base}topics/${series.id}/`}>{series.title}</a>.
      </p>
    </section>

    <section class="content-block">
      <h2>Join</h2>
      <div class="actions">
        <a
          class="btn btn-primary"
          href={registerUrl}
          id="register-link"
          target={registerReady ? "_blank" : undefined}
          rel={registerReady ? "noopener noreferrer" : undefined}
          >Register (Google Form)</a
        >
        <a
          class="btn btn-secondary"
          href={calendarUrl}
          target="_blank"
          rel="noopener noreferrer">Add to Google Calendar</a
        >
        <a
          class="btn btn-secondary is-disabled"
          href="#"
          id="zoom-link"
          aria-disabled="true">Zoom link (soon)</a
        >
      </div>
      <p class="note" id="register">
        {
          registerReady
            ? "Same Google Form for all Saturday events. Responses go to the linked Sheet."
            : "Registration form not linked yet — see scripts/create-registration-form.gs or README. Zoom: paste the meeting URL on the Zoom button when you have it."
        }
      </p>
    </section>

    <section class="content-block prose">
      <h2>After the event</h2>
      <ul>
        <li>Discussion summary — <em>not yet posted</em></li>
        <li>Podcast episode — <em>not yet posted</em></li>
      </ul>
    </section>
  </article>
</BaseLayout>
