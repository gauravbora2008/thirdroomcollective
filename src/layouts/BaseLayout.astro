---
import "../styles/main.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  current?:
    | "home"
    | "events"
    | "podcast"
    | "discussions"
    | "articles"
    | "topics"
    | "about";
  ogTitle?: string;
  ogDescription?: string;
}

const {
  title,
  description = "Events, discussions, podcasts, and essays in public philosophy.",
  current,
  ogTitle = "Third Room",
  ogDescription = "A place for serious public philosophy.",
} = Astro.props;

const siteUrl = new URL(
  import.meta.env.BASE_URL,
  Astro.site ?? "https://gauravbora2008.github.io",
).href;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={siteUrl} />
    <script is:inline>
      (function () {
        var t = localStorage.getItem("thirdroom-theme");
        if (t === "light" || t === "dark")
          document.documentElement.setAttribute("data-theme", t);
      })();
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Header current={current} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <script>
      /**
       * Theme toggle + mobile nav only.
       */
      const KEY = "thirdroom-theme";

      function theme() {
        return localStorage.getItem(KEY) === "light" ? "light" : "dark";
      }

      function apply(t: string) {
        document.documentElement.setAttribute("data-theme", t);
        const btn = document.getElementById("theme-toggle");
        if (!btn) return;
        const light = t === "light";
        btn.setAttribute(
          "aria-label",
          light ? "Switch to dark mode" : "Switch to light mode",
        );
        const moon = btn.querySelector(".icon-moon");
        const sun = btn.querySelector(".icon-sun");
        if (moon instanceof HTMLElement) moon.hidden = light;
        if (sun instanceof HTMLElement) sun.hidden = !light;
      }

      function initTheme() {
        apply(theme());
        const btn = document.getElementById("theme-toggle");
        if (!btn) return;
        btn.addEventListener("click", () => {
          const next = theme() === "dark" ? "light" : "dark";
          localStorage.setItem(KEY, next);
          apply(next);
        });
      }

      function initNav() {
        const toggle = document.getElementById("nav-toggle");
        const nav = document.getElementById("site-nav");
        if (!toggle || !nav) return;

        toggle.addEventListener("click", () => {
          const open = nav.classList.toggle("is-open");
          toggle.setAttribute("aria-expanded", open ? "true" : "false");
        });

        nav.querySelectorAll("a").forEach((a) => {
          a.addEventListener("click", () => {
            nav.classList.remove("is-open");
            toggle.setAttribute("aria-expanded", "false");
          });
        });

        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && nav.classList.contains("is-open")) {
            nav.classList.remove("is-open");
            toggle.setAttribute("aria-expanded", "false");
            toggle.focus();
          }
        });
      }

      initTheme();
      initNav();
    </script>
  </body>
</html>
